# Copy to .env.local and fill in. Never commit real values.

# Anthropic API key used for AI triage (only this variable is read).
# `npm run eval` also uses it to make real, billed calls; `npm test` never does.
# Leave empty to run without AI: Analyze then shows an honest
# "AI triage unavailable" state and requests are created untriaged.
ANTHROPIC_API_KEY=

# Model used for triage. Any model that supports structured outputs works:
# claude-sonnet-5-5 (default) or e.g. claude-opus-5-5. There is no automatic
# fallback to another model; a refusal or failure shows the unavailable state.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Per-attempt timeout for the triage call, in milliseconds.
TRIAGE_TIMEOUT_MS=45000

# Local SQLite database file.
DATABASE_PATH=./data/feature-intelligence.db
