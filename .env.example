# Copy to .env.local and fill in. Never commit real values.

# Anthropic API key used for AI triage. Leave empty to run without AI:
# the app will show an honest "AI triage unavailable" state (no fake output).
ANTHROPIC_API_KEY=

# Model used for triage.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Maximum time to wait for a triage response, in milliseconds.
TRIAGE_TIMEOUT_MS=20000

# Local SQLite database file.
DATABASE_PATH=./data/feature-intelligence.db
